# Variables de UNA tienda publicada con deploy/docker-compose.yml. Copia este archivo fuera del repositorio
# (ej. /opt/tiendas/alan.env), completa los valores y protégelo con `chmod 600`: tiene las claves de la tienda.
# Cada tienda tiene su propio archivo, con claves y contraseñas distintas.
#
#   docker compose -p alan -f deploy/docker-compose.yml --env-file /opt/tiendas/alan.env up -d --build
#
# Docker Compose interpreta el signo $ como una variable: las claves se generan con los comandos de abajo, que no
# lo usan (no uses get_random_secret_key de Django aquí).

# Ruta de este mismo archivo: el backend lee de aquí todas sus variables
ARCHIVO_TIENDA=/opt/tiendas/alan.env

# ===== Dirección de la tienda =====
# Con un proxy de borde que termina el HTTPS (varias tiendas en un servidor): ":80", y un PUERTO_WEB distinto por tienda.
# Con el dominio propio en este Caddy: DIRECCION_SITIO="mitienda.cl, www.mitienda.cl" (www lleva a mitienda.cl),
# IP_WEB=0.0.0.0, PUERTO_WEB=80 y PUERTO_WEB_HTTPS=443
DIRECCION_SITIO=:80
IP_WEB=127.0.0.1
PUERTO_WEB=8081
PUERTO_WEB_HTTPS=8441

# El dominio público, el mismo en las cuatro (con https:// en las tres últimas)
ALLOWED_HOSTS=alan-prueba.duckdns.org
CSRF_TRUSTED_ORIGINS=https://alan-prueba.duckdns.org
CORS_ALLOWED_ORIGINS=https://alan-prueba.duckdns.org
FRONTEND_URL=https://alan-prueba.duckdns.org

# ===== Django =====
DEBUG=False
# Genera cada una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Cambiar SECRET_KEY cierra las sesiones; cambiar CLAVE_CIFRADO_CREDENCIALES obliga a recargar los medios de pago.
SECRET_KEY=
CLAVE_CIFRADO_CREDENCIALES=
# Segundos que el navegador recuerda "solo HTTPS". Subir a 31536000 solo cuando todo funcione
SECURE_HSTS_SECONDS=3600
LOG_LEVEL=INFO
# Procesos e hilos de gunicorn (por defecto 2 y 4)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4

# ===== Bases de datos (servicios del mismo stack) =====
# Contraseñas solo con letras y números, porque van dentro de una URL. Genera cada una con:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=
MONGO_USUARIO=tienda
MONGO_CLAVE=
MONGO_BASE=tienda
# Caché de MongoDB en GB (por defecto 0.5): alcanza para un catálogo de tienda y deja memoria para otras tiendas
# MONGO_CACHE_GB=0.5

# ===== Inicio de sesión con Google (opcional) =====
# El mismo cliente OAuth sirve para varias tiendas: agrega el dominio de cada una en sus orígenes autorizados
GOOGLE_CLIENT_ID=

# ===== Correo =====
# Sin dominio propio: Gmail por SMTP con una contraseña de aplicación
RESEND_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
